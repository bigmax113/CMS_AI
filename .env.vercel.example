# CMS AI Vercel plug-and-play environment.
# Copy these names into Vercel Project Settings -> Environment Variables.
# Do not commit real secrets.

NODE_ENV=production
PNPM_HOME=/vercel/.local/share/pnpm

# Public URLs.
# Production: set both to https://<your-vercel-project>.vercel.app or to the custom domain.
NEXT_PUBLIC_SERVER_URL=https://<your-vercel-domain>
PAYLOAD_PUBLIC_SERVER_URL=https://<your-vercel-domain>

# Payload auth/admin.
PAYLOAD_SECRET=<generate-a-long-random-secret>
PAYLOAD_ADMIN_EMAIL=dev@payloadcms.com
PAYLOAD_ADMIN_PASSWORD=<set-admin-password>

# External Postgres. Recommended: Neon or Supabase.
# Use the pooled production connection string and include SSL:
# Neon example: postgres://...?...&sslmode=require
# Supabase example: postgres://...?...&sslmode=require
DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require
POSTGRES_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require
PGSSLMODE=require
PAYLOAD_DB_SCHEMA=cms_ai
PAYLOAD_DB_PUSH=false
PAYLOAD_RUN_MIGRATIONS=true
# Keep false/empty for a cloned production database.
# Set true only when bootstrapping an empty demo database.
CMS_AI_SEED_DEMO_DATA=false

# Cloud media storage. This is the same Google Drive-backed storage profile as Render.
GOOGLE_DRIVE_STORAGE_ENABLED=true
GOOGLE_DRIVE_PUBLIC_READ=true
GOOGLE_DRIVE_FOLDER_ID=<drive-folder-id>
GOOGLE_DRIVE_OAUTH_CLIENT_JSON_B64=<base64-oauth-client-json>
GOOGLE_DRIVE_OAUTH_TOKEN_JSON_B64=<base64-oauth-token-json>

# AI provider. Current prototype uses xAI-compatible endpoints, but the app keeps model names configurable.
XAI_API_KEY=<provider-api-key>
XAI_BASE_URL=https://api.x.ai/v1
GROK_TEXT_MODEL=grok-4.3
GROK_IMAGE_MODEL=grok-imagine-image
GROK_VIDEO_MODEL=grok-imagine-video
GROK_VIDEO_POLL_ATTEMPTS=12
GROK_VIDEO_POLL_INTERVAL_MS=5000

# Optional RAG semantic reranking.
XAI_EMBEDDING_MODEL=
